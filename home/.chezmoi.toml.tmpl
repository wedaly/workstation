{{- $gitConfigName := promptString "[gitconfig] name" -}}
{{- $gitConfigEmail := promptString "[gitconfig] email" -}}
{{- $gitSigningKey := promptString "[gitconfig] ssh pub key for signing commits/tags" -}}
[data.gitconfig]
	name = {{ $gitConfigName | quote }}
	email = {{ $gitConfigEmail | quote }}
    signingKey = {{ $gitSigningKey | quote }}

[data.addons]
	tmux = {{ promptBool "[addons] install tmux? [y/n]" }}
	kubectl = {{ promptBool "[addons] install kubectl? [y/n]" }}
	docker = {{ promptBool "[addons] install docker? [y/n]" }}
	godev = {{ promptBool "[addons] install golang dev tools? [y/n]" }}
	rust = {{ promptBool "[addons] install rust? [y/n]" }}

{{ $supportBidi := promptBool "[bidi] enable bidi isolate? [y/n]" -}}
[data.bidi]
	enabled = {{ $supportBidi }}
