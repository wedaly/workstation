#!/usr/bin/env sh
set -e

GO_VERSION=1.27.4
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") }}
    GO_SHA256SUM=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
{{- else if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") }}
    GO_SHA256SUM=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92
{{- else if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
    GO_SHA256SUM=91a44a2b8a716600ad94a4f143e156116620db8828086a6e3602291be9bd0bb4
{{- end }}

{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "ubuntu" -}}
echo "Installing system packages (apt)"
sudo apt update
sudo apt install \
    vim \
    wget \
    curl \
    git \
    keychain \
    tree \
    jq \
    ripgrep \
    fzf \
    htop \
    python3 \
    python3-pip \
    universal-ctags \
    ca-certificates \
    gnupg \
    apt-transport-https \
    libssl-dev \
    pkg-config

{{ else if eq .chezmoi.osRelease.id "fedora" -}}
echo "Installing system packages (dnf)"
sudo dnf update
sudo dnf install \
    vim \
    wget \
    curl \
    git \
    make \
    gcc \
    tree \
    jq \
    ripgrep \
    fzf \
    htop \
    python3 \
    ctags \
    keychain \
    openssl-devel

{{ end -}}

{{ else if eq .chezmoi.os "darwin" -}}
echo "Installing system packages (brew)"
brew install --quiet \
    coreutils \
    bash \
    bash-completion@2 \
    vim \
    wget \
    curl \
    git \
    tree \
    jq \
    sd \
    ripgrep \
    fzf \
    gnupg \
    python3 \
    gnu-sed \
    universal-ctags
{{ end -}}

INSTALL_DIR=$(mktemp -d)
trap 'rm -rf "$INSTALL_DIR"' EXIT HUP INT TERM

{{- if eq .chezmoi.os "linux" }}
echo "Installing sd"
SD_VERSION=1.1.0
{{ if eq .chezmoi.arch "amd64" -}}
SD_TARGET=x86_64-unknown-linux-musl
SD_SHA256SUM=02f00f4777d43e8e95b7b8d49e1a0d6e502fed4b8e79c1c8b8063857a30caa2e
{{ else if eq .chezmoi.arch "arm64" -}}
SD_TARGET=aarch64-unknown-linux-musl
SD_SHA256SUM=ec8c93c0533ff21f4851d11566808d4082544baf063d9b96ea77c27e98b7cd99
{{ else -}}
echo "Unsupported Linux architecture: {{ .chezmoi.arch }}" >&2
exit 1
{{ end -}}
SD_TARBALL="sd-v${SD_VERSION}-${SD_TARGET}.tar.gz"
curl -fsSL "https://github.com/chmln/sd/releases/download/v${SD_VERSION}/${SD_TARBALL}" -o "$INSTALL_DIR/$SD_TARBALL"
(cd "$INSTALL_DIR" && echo "$SD_SHA256SUM  $SD_TARBALL" | sha256sum --check --status)
tar -xzf "$INSTALL_DIR/$SD_TARBALL" -C "$INSTALL_DIR"
sudo install -m 0755 "$INSTALL_DIR/sd-v${SD_VERSION}-${SD_TARGET}/sd" /usr/local/bin/sd
{{ end -}}

echo "Installing go"
if (which go && go version | cut -d ' ' -f 3 | grep "go$GO_VERSION"); then
    echo "go v$GO_VERSION is already installed"
else
    GO_OS={{ .chezmoi.os }}
    GO_ARCH={{ .chezmoi.arch }}
    GO_TARBALL="go${GO_VERSION}.${GO_OS}-${GO_ARCH}.tar.gz"
    (cd /tmp && rm -rf "$GO_TARBALL" && wget https://go.dev/dl/${GO_TARBALL} && echo "$GO_SHA256SUM  $GO_TARBALL" | sha256sum --check --status)
    sudo rm -rf /usr/local/go
    sudo tar -C /usr/local -xzf "/tmp/$GO_TARBALL"
    export PATH=$PATH:/usr/local/go/bin:$HOME/go/bin
fi

echo "Installing aretext"
git clone https://github.com/aretext/aretext "$INSTALL_DIR/aretext"
(cd "$INSTALL_DIR/aretext" && make install)
